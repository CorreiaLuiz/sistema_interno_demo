# Servidor
PORT=3000
NODE_ENV=development
# Endereço pelo qual os colaboradores acessam o sistema — usado nos links
# enviados por e-mail (ex: recuperação de senha). Ex: http://IP-DO-SERVIDOR:3000
APP_URL=http://localhost:3000
# Origens extras liberadas no CORS, separadas por vírgula (só necessário se o
# front-end for aberto por outro endereço, ex: Live Server na porta 5500)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=legalizacao_db
DB_USER=postgres
DB_PASSWORD=troque_esta_senha

# JWT — mínimo 32 caracteres, o servidor não sobe sem isso. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Backup automático (database\backup.ps1 — ver database\RESTAURACAO.md)
# Pasta para uma cópia extra fora do computador (OneDrive da empresa, HD externo).
# Vazio = backups só em database\backups.
BACKUP_PASTA_COPIA=
# Diários guardados por X dias; o primeiro backup de cada mês, por Y meses.
BACKUP_DIAS_PARA_MANTER=30
BACKUP_MESES_MENSAIS=12

# Sessão da Área do Cliente (login do cliente)
JWT_CLIENTE_EXPIRES_IN=12h

# Quem recebe os pedidos feitos pelo cliente na Área do Cliente. Vazio =
# usa os responsáveis setoriais da esteira (ONBOARDING_FISCAL/CONTABIL/FOLHA).
PORTAL_RESPONSAVEL_FISCAL_EMAIL=
PORTAL_RESPONSAVEL_CONTABILIDADE_EMAIL=
PORTAL_RESPONSAVEL_FOLHA_PAGAMENTO_EMAIL=
# Pedidos de Legalização (vazio = ONBOARDING_LEGALIZACAO_EMAIL)
PORTAL_RESPONSAVEL_LEGALIZACAO_EMAIL=

# Upload
UPLOAD_MAX_SIZE_MB=15

# Seed do usuário administrador inicial (usado apenas por seedAdmin.js).
# Depois de criar o admin, apague a senha daqui.
ADMIN_EMAIL=admin@demo.com.br
ADMIN_SENHA=
ADMIN_NOME=Administrador

# Notificações — e-mail (opcional; sem isso, o envio fica simulado/logado no console)
# Opção 1 — Microsoft Graph (recomendado para Microsoft 365): NOTIF_EMAIL_VIA=graph
#   + AZURE_* abaixo, com permissão de aplicativo "Mail.Send". Envia pela caixa NOTIF_EMAIL_FROM.
# Opção 2 — SMTP: deixe NOTIF_EMAIL_VIA vazio e preencha HOST/PORT/USER/PASS.
NOTIF_EMAIL_VIA=
# Se o e-mail for Microsoft 365/Outlook: HOST=smtp.office365.com, PORT=587, SECURE=false
NOTIF_EMAIL_HOST=
NOTIF_EMAIL_PORT=587
NOTIF_EMAIL_SECURE=false
NOTIF_EMAIL_USER=
NOTIF_EMAIL_PASS=
NOTIF_EMAIL_FROM=avisos@seu-escritorio.com.br

# Notificações — WhatsApp (opcional; sem isso, o envio fica simulado/logado no console)
# URL autenticada gerada no painel do provedor em Configurações -> API/Webhook -> Adicionar
NOTIF_WHATSAPP_API_URL=
NOTIF_WHATSAPP_TOKEN=

# Outlook — criação automática de evento de calendário ao cadastrar uma
# tarefa de setor com prazo (opcional; sem isso, a criação do evento fica
# simulada/logada no console). Requer um app registrado no Azure com
# permissão de aplicativo "Calendars.ReadWrite" e consentimento de
# administrador concedido (ver README para o passo a passo).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Esteira de integração de empresa nova (Cadastro → Legalização →
# Cadastro no Domínio → Fechamento setorial). Preencha com o e-mail de
# cada responsável fixo; enquanto estiver vazio, cai no e-mail de teste.
ONBOARDING_EMAIL_TESTE=
ONBOARDING_LEGALIZACAO_EMAIL=
ONBOARDING_CADASTRO_EMAIL=
ONBOARDING_FISCAL_EMAIL=
ONBOARDING_CONTABIL_EMAIL=
ONBOARDING_FOLHA_EMAIL=

# Avisos gerais do escritório (empresa nova, cadastrada no Domínio, saída do escritório).
# E-mails separados por vírgula — pode ser um e-mail de grupo. Se ficar vazio,
# o aviso vai para todos os usuários ativos do sistema (bom para testes).
EMAIL_AVISOS_GERAIS=

# Conferência bancária — leitura (somente consulta) do banco do Domínio via ODBC
# (DSN de 32/64 bits configurado no Windows) e das pastas das empresas.
DOMINIO_DSN=Contabil
DOMINIO_USUARIO=
DOMINIO_SENHA=
CB_PASTA_EMPRESAS=
CB_PLANILHA=

# CND Federal (Receita + PGFN) pela API "Consulta CND" do SERPRO — botão "CND Federal"
# na tela Empresas. Chaves: Área do Cliente do SERPRO → "Informações das chaves".
# Cada consulta é cobrada pelo SERPRO. Vazio = botão desligado.
SERPRO_CND_CONSUMER_KEY=
SERPRO_CND_CONSUMER_SECRET=

# Integra Contador (SERPRO) — guias, declarações e Caixa Postal da Receita em nome dos clientes.
# Chaves do contrato do Integra (Área do Cliente → "Chaves de Acesso") + e-CNPJ do escritório
# (o MESMO CNPJ do contrato). Caminho com barras normais (/); pode ser no servidor de arquivos.
# Cada chamada com resultado é cobrada pelo SERPRO; a entrada (token) não é.
SERPRO_INTEGRA_CONSUMER_KEY=
SERPRO_INTEGRA_CONSUMER_SECRET=
SERPRO_INTEGRA_CERT_PATH=
SERPRO_INTEGRA_CERT_SENHA=

# Assistente de dúvidas (botão "Dúvidas?" no sistema e na Área do Cliente).
# Sem a chave, ele responde pela busca no manual (sem custo). Com a chave da API do Claude
# (console.anthropic.com → API Keys), responde com IA usando só o manual. Cada pergunta custa
# centavos; AJUDA_LIMITE_DIA limita quantas perguntas por dia vão para a IA (padrão 300).
ANTHROPIC_API_KEY=
AJUDA_LIMITE_DIA=300

# Formulário "Agende o seu diagnóstico" da página Sobre: e-mail que recebe cada pedido
# (vazio = ADMIN_EMAIL). A lista completa fica em Contatos do site (administrador).
CONTATO_SITE_EMAIL=
