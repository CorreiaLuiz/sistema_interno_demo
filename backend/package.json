{
  "name": "sistema-privilege-demo",
  "version": "1.0.0",
  "description": "API interna para gestão de legalização de empresas, CNDs e licenças",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:admin": "node src/utils/seedAdmin.js",
    "test": "node --test tests/*.test.js",
    "demo:preparar": "node demo/preparar.js",
    "demo:recriar": "node demo/preparar.js --recriar",
    "demo": "node demo/preparar.js --se-preciso && node src/server.js",
    "verificar": "tsc -p tsconfig.json",
    "manual:prints": "node manuais/gerar-prints.js",
    "test:integracao": "node --test --test-concurrency=1 tests/integracao/*.test.js",
    "banco:novo": "node src/utils/bancoNovo.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-forge": "^1.3.1",
    "nodemailer": "^9.0.4",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/node-forge": "^1.3.11",
    "nodemon": "^3.1.4",
    "typescript": "^5.6.3"
  }
}
